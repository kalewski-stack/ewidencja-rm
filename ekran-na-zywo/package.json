{
  "name": "ekran-na-zywo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ekran na żywo: ankieta, infografiki, pytania do ekspertów i rekomendacje na konferencję (Radom, 25.11.2026)",
  "scripts": {
    "prepare:content": "node scripts/prepare.ts",
    "build": "node scripts/prepare.ts --production && vite build --config apps/web/vite.config.ts",
    "build:dev": "node scripts/prepare.ts && vite build --config apps/web/vite.config.ts --mode development",
    "dev": "npm run build:dev && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "qr": "node scripts/qr.ts",
    "export:static": "node scripts/export-static.ts",
    "loadtest": "node scripts/loadtest.ts",
    "test": "node --test --test-concurrency=1 scripts/tests/e2e.test.ts",
    "purge": "node scripts/purge.ts",
    "audit": "node scripts/audit.ts",
    "secrets": "node scripts/secrets.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "preact": "^10.24.0",
    "qrcode-generator": "^1.4.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@preact/preset-vite": "^2.9.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
